<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>EnginePseudo3D.DataPipes</PackageId>
    <Title>EnginePseudo3D.DataPipes</Title>
    <Version>1.0.3</Version>
    <Authors>Speyd</Authors>
    <Company>Speyd</Company>
    <Description>This is a library for computing with data.</Description>
    <Product>EnginePseudo3D</Product>
    <Copyright>Speyd</Copyright>
    <PackageIcon>iconNuGet.png</PackageIcon>
    <RepositoryUrl>https://github.com/Speyd/Game2_5D/tree/Version_3_0/DataPipes</RepositoryUrl>
    <PackageReadmeFile>README_DataPipes.md</PackageReadmeFile>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="C:\Users\Admin\Desktop\README_DataPipes.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="C:\Users\Admin\Downloads\iconNuGet.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SFML.Graphics" Version="2.6.1" />
    <PackageReference Include="SFML.System" Version="2.6.1" />
  </ItemGroup>

</Project>
