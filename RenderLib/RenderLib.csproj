<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>EnginePseudo3D.RenderLib</PackageId>
    <Title>EnginePseudo3D.RenderLib</Title>
    <Product>EnginePseudo3D</Product>
    <Version>1.0.6</Version>
    <Authors>Speyd</Authors>
    <Company>Speyd</Company>
    <Copyright>Speyd</Copyright>
    <Description>This is a library for rendering objects.</Description>
    <PackageIcon>iconNuGet.png</PackageIcon>
    <PackageReadmeFile>README_RenderLib.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Speyd/Game2_5D/tree/Version_3_0/RenderLib</RepositoryUrl>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="C:\Users\Admin\Desktop\README_RenderLib.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="C:\Users\Admin\Downloads\iconNuGet.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NGenerics" Version="1.5.3" />
    <PackageReference Include="SFML.Net" Version="2.6.1" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="EnginePseudo3D.DataPipes" Version="1.0.2" />
	  <PackageReference Include="EnginePseudo3D.EntityLib" Version="1.0.3" />
	  <PackageReference Include="EnginePseudo3D.MapLib" Version="1.0.6" />
	  <PackageReference Include="EnginePseudo3D.ProtoRender" Version="1.0.6" />
	  <PackageReference Include="EnginePseudo3D.ScreenLib" Version="1.0.2" />
  </ItemGroup>

</Project>
