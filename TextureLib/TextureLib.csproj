<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>EnginePseudo3D.TextureLib</PackageId>
    <Title>EnginePseudo3D.TextureLib</Title>
    <Version>1.7.3</Version>
    <Authors>Speyd</Authors>
    <Company>Speyd</Company>
    <Product>EnginePseudo3D</Product>
    <Description>This is a library for creating and using Textures.</Description>
    <Copyright>Speyd</Copyright>
    <PackageIcon>iconNuGet.png</PackageIcon>
    <RepositoryUrl>https://github.com/Speyd/Game2_5D/tree/Version_3_0/TextureLib</RepositoryUrl>
    <PackageReadmeFile>README_TextureLib.md</PackageReadmeFile>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="C:\Users\Admin\Desktop\README_TextureLib.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="C:\Users\Admin\Downloads\iconNuGet.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
     <PackageReference Include="EnginePseudo3D.DataPipes" Version="1.3.0" />
     <PackageReference Include="EnginePseudo3D.ScreenLib" Version="1.0.6" />
	 <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.9.1" />
  </ItemGroup>

</Project>
