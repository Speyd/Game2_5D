<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>EnginePseudo3D.MiniMapLib</PackageId>
    <Title>EnginePseudo3D.MiniMapLib</Title>
    <Product>EnginePseudo3D</Product>
    <Authors>Speyd</Authors>
    <Company>Speyd</Company>
    <Copyright>Speyd</Copyright>
    <Version>2.1.8</Version>
    <Description>This is a library for creating and rendering a minimap.</Description>
    <PackageIcon>iconNuGet.png</PackageIcon>
    <RepositoryUrl>https://github.com/Speyd/Game2_5D/tree/Version_3_0/MiniMapLib</RepositoryUrl>
    <PackageReadmeFile>README_MiniMapLib.md</PackageReadmeFile>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="C:\Users\Admin\Desktop\README_MiniMapLib.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="C:\Users\Admin\Downloads\iconNuGet.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EnginePseudo3D.ProtoRender" Version="2.3.0" />
    <PackageReference Include="SFML.Net" Version="2.6.1" />
  </ItemGroup>

</Project>
